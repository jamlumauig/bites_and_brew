{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "store": {
      "catalog": {
        ".read": true,
        ".write": "auth != null && auth.token.role === 'admin'"
      },
      "orders": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "customer_orders": {
      "$orderNumber": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
